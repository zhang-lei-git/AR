[Unit]
Description=AR Production Support Demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ar-production-support-demo/current
ExecStart=/usr/bin/python3 /opt/ar-production-support-demo/current/server.py --host 0.0.0.0 --port 5008 --db /opt/ar-production-support-demo/data/ar_demo.db
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ar-production-support-demo/data

[Install]
WantedBy=multi-user.target
